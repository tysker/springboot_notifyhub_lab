<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- Project Information -->
    <groupId>io.github.tysker</groupId>
    <artifactId>notifyhub</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <!-- Information   -->
    <name>notifyhub</name>
    <description>root module for notifyhub</description>

    <!-- Project Developers -->
    <developers>
        <developer>
            <name>Jörg O.</name>
            <email>tysker@example.com</email>
        </developer>
    </developers>

    <!-- Project Modules -->
    <modules>
        <module>notifyhub-api</module>
        <module>notifyhub-app</module>
        <module>notifyhub-core</module>
    </modules>

    <!-- Project Properties -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Project Dependencies -->
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>io.github.tysker</groupId>
                <artifactId>notifyhub-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.tysker</groupId>
                <artifactId>notifyhub-core</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
